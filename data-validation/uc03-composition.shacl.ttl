# UC-03 composition rules for reference expressions (#168).
#
# These rules check DATA (the individuals an extraction pipeline produces), not the ontology. They are written
# down in docs/specification/use-cases/UC-03/design-notes/uc03-provenance-profile.md and are closed-world checks,
# so they are deliberately not OWL axioms: an existential restriction would infer an anonymous mention with no
# evidence, and a `max 1` or a functional axiom would merge two distinct mentions instead of reporting the
# conflict. What is read here is documented in docs/contribute/data-validation.md.
#
# The reference terms are defined in adiro_drawing_symbology (#277). The IRIs they had in adiro_drawing_metadata stay, deprecated and
# equivalent to the new ones, and data written before the move uses them, so each shape targets and counts both.
#
# Severity: sh:Violation. The conditions are structural: a graph that breaks one is malformed, not merely incomplete.

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix metadata: <https://w3id.org/adiro/adiro_drawing_metadata#> .
@prefix dsym: <https://w3id.org/adiro/adiro_drawing_symbology#> .
@prefix dv: <https://w3id.org/adiro/data-validation/uc03-composition#> .

dv:InlineReferenceComposition a sh:NodeShape ;
    sh:targetClass dsym:InlineLayoutDrawingReference , metadata:InlineLayoutSheetReference ;
    sh:severity sh:Violation ;
    sh:property [
        sh:severity sh:Violation ;
        sh:path metadata:contains ;
        sh:qualifiedValueShape [ sh:or ( [ sh:class dsym:DrawingIdentifierMention ] [ sh:class metadata:DrawingIdentifierMention ] ) ] ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        sh:message "An inline layout and drawing reference contains exactly one drawing identifier mention."
    ] ;
    sh:property [
        sh:severity sh:Violation ;
        sh:path metadata:contains ;
        sh:qualifiedValueShape [ sh:or ( [ sh:class dsym:LayoutIdentifierMention ] [ sh:class metadata:LayoutIdentifierMention ] ) ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "An inline layout and drawing reference contains at least one layout identifier mention."
    ] .

dv:ReferenceSymbolComposition a sh:NodeShape ;
    sh:targetClass dsym:ReferenceSymbol ;
    sh:severity sh:Violation ;
    sh:property [
        sh:severity sh:Violation ;
        sh:path metadata:contains ;
        sh:qualifiedValueShape [ sh:or ( [ sh:class dsym:DrawingIdentifierMention ] [ sh:class metadata:DrawingIdentifierMention ] ) ] ;
        sh:qualifiedMaxCount 1 ;
        sh:message "A reference symbol contains at most one drawing identifier mention."
    ] .

dv:MentionTarget a sh:NodeShape ;
    sh:targetClass dsym:DrawingIdentifierMention , metadata:DrawingIdentifierMention ;
    sh:severity sh:Violation ;
    sh:property [
        sh:severity sh:Violation ;
        sh:path dsym:denotesDrawingSheet ;
        sh:maxCount 1 ;
        sh:message "A drawing identifier mention has at most one accepted denotesDrawingSheet target."
    ] ;
    sh:property [
        sh:severity sh:Violation ;
        sh:path metadata:denotesDrawingSheet ;
        sh:maxCount 1 ;
        sh:message "A drawing identifier mention has at most one accepted denotesDrawingSheet target."
    ] .
