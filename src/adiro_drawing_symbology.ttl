@prefix : <https://w3id.org/adiro/adiro_drawing_symbology#> .
@prefix admeta: <https://w3id.org/adiro/adiro_drawing_metadata#> .
@prefix img: <https://w3id.org/adiro/adiro_drawing_symbology/exampleImage/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/adiro/adiro_drawing_symbology> rdf:type owl:Ontology ;
    rdfs:label "ADIRO Drawing Symbology Ontology" ;
    rdfs:comment "The symbols and marks a drawing uses, shared by every discipline: reusable symbols and text that appear across disciplines, such as dimensions, grids, levels and references to another layout or drawing: the graphical reference symbol, the inline and standalone reference expressions, and the occurrences of drawing and layout identifiers they are made of. Every one is a kind of drawing element from the drawing-metadata module. The discipline modules build on them." ;
    dcterms:title "ADIRO Drawing Symbology Ontology" ;
    vann:preferredNamespacePrefix "adsym" ;
    vann:preferredNamespaceUri "https://w3id.org/adiro/adiro_drawing_symbology#"^^xsd:anyURI ;
    dcterms:issued "2026-11-26"^^xsd:date ;
    dcterms:modified "2026-11-27"^^xsd:date ;
    dcterms:description "The symbols and marks a drawing uses, shared by every discipline: reusable symbols and text that appear across disciplines, such as dimensions, grids, levels and references to another layout or drawing: the graphical reference symbol, the inline and standalone reference expressions, and the occurrences of drawing and layout identifiers they are made of. Every one is a kind of drawing element from the drawing-metadata module. The discipline modules build on them." ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:creator "Buro Happold — Machine Learning R&D" ;
    dcterms:publisher "Buro Happold" ;
    dcterms:replaces <https://w3id.org/adiro/adiro_common_symbols> ;
    owl:priorVersion <https://w3id.org/adiro/aec_common_symbols/1.0.0> ;
    owl:priorVersion <https://w3id.org/adiro/aec_common_symbols/2.0.0> ;
    owl:priorVersion <https://w3id.org/adiro/aec_common_symbols/3.0.0> ;
    owl:priorVersion <https://w3id.org/adiro/aec_common_symbols/3.0.1> ;
    owl:priorVersion <https://w3id.org/adiro/aec_common_symbols/4.0.0> ;
    owl:priorVersion <https://w3id.org/adiro/aec_common_symbols/4.0.1> ;
    owl:priorVersion <https://w3id.org/adiro/adiro_common_symbols/5.0.0> ;
    owl:priorVersion <https://w3id.org/adiro/adiro_common_symbols/5.0.1> ;
    owl:priorVersion <https://w3id.org/adiro/adiro_drawing_symbology/6.0.0> ;
    owl:versionIRI <https://w3id.org/adiro/adiro_drawing_symbology/6.0.1> ;
    owl:versionInfo "6.0.1" ;
    owl:imports <https://w3id.org/adiro/adiro_drawing_metadata> .


#################################################################
#    Classes — Generic drawing symbols
#################################################################

:Dimension rdf:type owl:Class;
    rdfs:subClassOf admeta:DrawingElement;
    rdfs:label "Dimension";
    skos:definition "A dimension line or dimension annotation on a drawing, indicating measurements or distances."@en;
    admeta:exampleImage img:Dimension_01.png;
    admeta:isComputerVisionLabel "true"^^xsd:boolean.

:Grid rdf:type owl:Class;
    rdfs:subClassOf admeta:DrawingElement;
    rdfs:label "Grid";
    skos:definition "A grid line or grid system used for alignment and reference in architectural drawings."@en;
    rdfs:comment "Not the grid reference system of ISO 5457:1999 §4.4, which divides the sheet into lettered and numbered fields; Grid is about the building's grid, not the sheet's.";
    admeta:exampleImage img:Grid_01.png;
    admeta:isComputerVisionLabel "true"^^xsd:boolean.

#################################################################
#    Classes — UC-03 reference expressions and text occurrences
#################################################################

:ReferenceExpression rdf:type owl:Class;
    rdfs:subClassOf admeta:DrawingElement;
    rdfs:label "Reference expression";
    skos:definition "A complete source reference expression, whether graphical, inline or a standalone drawing-identifier reference."@en;
    rdfs:comment "This superclass groups those forms for queries; it does not require a second individual around any of them. ISO 7519:2025 §4.3.1 asks that a set of drawings reference the views and details that give further information, and allows hyperlinks to other drawings, files or digital objects, and ISO 128-3:2022 §5.1 allows the designation on a construction drawing to be complemented by a reference to other drawings; neither records whether a reference has been resolved to its target, which ADIRO records as a separate accepted edge.";
    admeta:isComputerVisionLabel "true"^^xsd:boolean.

:DrawingIdentifierMention rdf:type owl:Class;
    rdfs:subClassOf admeta:DrawingElement;
    rdfs:label "Drawing identifier mention";
    skos:definition "One evidenced occurrence of drawing-identifier text on a source drawing, distinct from the DrawingSheet that the text may denote."@en;
    rdfs:comment "Source-text evidence and an immutable source identity are admission requirements for exported UC-03 mentions. Precise localisation is required for navigation, not for an independently accepted resolution to a DrawingSheet: an unlocalisable text block may retain its accepted denotesDrawingSheet edge without a fabricated bounding box or clickable link. Unresolved candidates remain in extraction evidence; no geometry cardinality axiom is imposed. The text it records is a drawing's identification number (ISO 7200:2004 §5.1.3). Where a project uses its file information container ID as the drawing number, a drawing identifier mention may reproduce that ID; the UK National Annex to BS EN ISO 19650-2:2018 (2021 revision), NA.2.2 and Figure NA.1, describes the composition of that ID.";
    admeta:exampleImage img:DrawingIdentifierMention_02.png;
    admeta:exampleImage img:DrawingIdentifierMention_03.png;
    admeta:isComputerVisionLabel "true"^^xsd:boolean.

:LayoutIdentifierMention rdf:type owl:Class;
    rdfs:subClassOf admeta:DrawingElement;
    rdfs:label "Layout identifier mention";
    skos:definition "One evidenced occurrence of layout-identifier text (a short identifier, such as a number, a letter or a sheet-grid coordinate), distinct from a target Layout."@en;
    rdfs:comment "A complete inline reference may contain several such occurrences, attached with contains; no target is inferred from matching text alone. The text it records is the designation of a view in ISO 128-3:2022 §4.1.";
    admeta:exampleImage img:LayoutIdentifierMention_02.png;
    admeta:exampleImage img:LayoutIdentifierMention_03.png;
    admeta:isComputerVisionLabel "true"^^xsd:boolean.

:InlineLayoutDrawingReference rdf:type owl:Class;
    rdfs:subClassOf :ReferenceExpression;
    rdfs:label "Inline Layout and Drawing Reference";
    skos:definition "A complete inline textual expression relating layout identifier(s) to a drawing identifier, such as '1, 3, 5 & 7/S601'."@en;
    rdfs:comment "The component mentions retain their own identities; accepted Layout targets are connected separately by inlineReferencesLayout. Expected composition: one DrawingIdentifierMention and at least one LayoutIdentifierMention, attached with contains; this is checked as an application-profile condition, not asserted as an OWL restriction. Corresponds to the designation of a view or section supplemented by a slash and the drawing number, which ISO 128-3:2022 Annex F, F.4, allows. ISO shows one designation per reference; ADIRO also allows several layouts on one drawing.";
    admeta:exampleImage img:InlineLayoutDrawingReference_02.png;
    admeta:exampleImage img:InlineLayoutDrawingReference_03.png;
    admeta:isComputerVisionLabel "true"^^xsd:boolean.

:StandaloneDrawingReference rdf:type owl:Class;
    rdfs:subClassOf :DrawingIdentifierMention, :ReferenceExpression;
    rdfs:label "Standalone Drawing Reference";
    skos:definition "A drawing-identifier occurrence that itself constitutes a complete reference to a drawing. An entry naming a drawing in a drawing index is one."@en;
    rdfs:comment "One individual is both the DrawingIdentifierMention and the ReferenceExpression: no duplicate wrapper, self-directed contains edge or second geometry is needed. An ungrouped mention is not automatically standalone merely because its parent has not been identified. Corresponds to a reference to another drawing in ISO 9431:1990 §5.2.4, and more generally to the references between the drawings of a set in ISO 7519:2025 §4.3.1. That an identifier standing alone is a complete reference is ADIRO's rule, not a requirement of either standard.";
    admeta:exampleImage img:StandaloneDrawingReference_02.png;
    admeta:exampleImage img:StandaloneDrawingReference_03.png;
    admeta:exampleImage img:StandaloneDrawingReference_04.png;
    admeta:exampleImage img:StandaloneDrawingReference_05.png;
    admeta:exampleImage img:StandaloneDrawingReference_06.png;
    admeta:exampleImage img:StandaloneDrawingReference_07.png;
    admeta:exampleImage img:StandaloneDrawingReference_08.png;
    admeta:isComputerVisionLabel "true"^^xsd:boolean.

#################################################################
#    Object Properties — UC-03 reference occurrences
#################################################################

:denotesDrawingSheet rdf:type owl:ObjectProperty ;
    rdfs:label "denotesDrawingSheet" ;
    skos:definition "The DrawingSheet that one occurrence of a drawing number on a drawing has been accepted as naming."@en ;
    rdfs:comment "It does not assert that a Layout target or an output-PDF navigation link was resolved. A mention is expected to have at most one accepted DrawingSheet; this is an application-profile condition, not an OWL functional axiom, because a functional axiom would make a reasoner merge two drawings instead of reporting the conflict." ;
    rdfs:domain :DrawingIdentifierMention ;
    rdfs:range admeta:DrawingSheet .

:inlineReferencesLayout rdf:type owl:ObjectProperty ;
    rdfs:label "inlineReferencesLayout" ;
    skos:definition "An accepted target Layout of an inline reference to layouts and a drawing."@en ;
    rdfs:comment "Multiple supported targets may be asserted; unresolved members do not acquire target edges." ;
    rdfs:domain :InlineLayoutDrawingReference ;
    rdfs:range admeta:Layout .

#################################################################
#    Classes — UC-03 Reference Symbol (cross-sheet linking)
#################################################################

:ReferenceSymbol rdf:type owl:Class;
    rdfs:subClassOf :ReferenceExpression;
    rdfs:label "ReferenceSymbol";
    skos:definition "A symbol drawn on a Layout that references another Layout (on the same or a different DrawingSheet)."@en;
    rdfs:comment "Replaces the earlier Callout class. Typical instances include Detail Markers, Section Markers, and Elevation Markers. The marker type is not modelled — it is derivable from the target Layout's LayoutContentType. Corresponds to a view designation with its reference arrow or cutting-plane line in ISO 128-3:2022 (§4.1, §4.12, §6.2.1 to §6.2.4) and to a callout in ISO 7519:2025 §4.3.1.";
    admeta:exampleImage img:ReferenceSymbol_02.png;
    admeta:exampleImage img:ReferenceSymbol_03.png;
    admeta:exampleImage img:ReferenceSymbol_04.png;
    admeta:exampleImage img:ReferenceSymbol_05.png;
    admeta:exampleImage img:ReferenceSymbol_06.png;
    admeta:exampleImage img:ReferenceSymbol_07.png;
    admeta:isComputerVisionLabel "true"^^xsd:boolean.

#################################################################
#    Object Properties — UC-03 Reference Symbol relations
#################################################################

:hasReferenceSymbol rdf:type owl:ObjectProperty ;
    rdfs:label "hasReferenceSymbol" ;
    skos:definition "A ReferenceSymbol drawn on this Layout."@en ;
    rdfs:comment "A Layout may contain several. To navigate from a symbol back to the Layout it is drawn on, use the SPARQL inverse path ^adsym:hasReferenceSymbol - ADIRO declares no named inverse properties and no owl:inverseOf axioms (see GitHub issue #21)." ;
    rdfs:subPropertyOf admeta:contains ;
    rdfs:domain admeta:Layout ;
    rdfs:range :ReferenceSymbol .

:referencesLayout rdf:type owl:ObjectProperty ;
    rdfs:label "referencesLayout" ;
    skos:definition "The target Layout that this ReferenceSymbol points to."@en ;
    rdfs:comment "The target is Layout-level, not DrawingSheet-level. To find the symbols pointing AT a Layout, use the SPARQL inverse path ^adsym:referencesLayout - ADIRO declares no named inverse properties and no owl:inverseOf axioms (see GitHub issue #21). In ISO 128-3:2022 §4.1 a reference and the view it points to are linked only by carrying the same designation; ADIRO records the accepted target as an edge." ;
    rdfs:domain :ReferenceSymbol ;
    rdfs:range admeta:Layout .
