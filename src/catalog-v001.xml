<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  OASIS XML catalog for OFFLINE import resolution (RES-36).

  Each ADIRO module owl:imports the others via their unversioned ("latest")
  w3id.org/adiro ontology IRIs. This catalog maps those IRIs to the local
  working-tree TTL files (paths are relative to this file, i.e. the src/
  directory), so ROBOT / the OWL API reason over *this branch's* sources
  instead of fetching the published copies over the network. This makes the
  reasoning CI deterministic (it checks the PR, not what's already deployed)
  and network-independent.

  Consumed via ROBOT's catalog option (robot merge ... catalog src/catalog-v001.xml).
-->
<catalog prefer="public" xmlns="urn:oasis:names:tc:entity:xmlns:xml:catalog">
  <uri name="https://w3id.org/adiro/aec_drawing_metadata" uri="aec_drawing_metadata.ttl"/>
  <uri name="https://w3id.org/adiro/aec_titleblock" uri="aec_titleblock.ttl"/>
  <uri name="https://w3id.org/adiro/aec_common_symbols" uri="aec_common_symbols.ttl"/>
  <uri name="https://w3id.org/adiro/aec_domain_common" uri="aec_domain_common.ttl"/>
  <uri name="https://w3id.org/adiro/aec_facade_domain" uri="aec_facade_domain.ttl"/>
</catalog>
