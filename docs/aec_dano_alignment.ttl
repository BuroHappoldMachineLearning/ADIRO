@base <https://w3id.org/adiro/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix aprov: <https://w3id.org/adiro/aec_provenance#> .
@prefix dano: <https://w3id.org/dano#> .

#################################################################
#    Ontology
#################################################################

<https://w3id.org/adiro/aec_dano_alignment> rdf:type owl:Ontology ;
    rdfs:label "ADIRO - DAnO compatibility layer" ;
    rdfs:comment "OPTIONAL compatibility layer mapping ADIRO terms to the Drawing Analysis Ontology (DAnO, https://w3id.org/dano). Nothing in the ADIRO core imports this module and no ADIRO core module mentions DAnO, so a consumer who wants the DAnO crosswalk loads this file explicitly and everyone else never sees it. Every mapping is annotation-level (skos:closeMatch) and carries no logical force: no rdfs:subPropertyOf alignment to a DAnO term is available, and the DAnO IRIs are not declared here or anywhere else in ADIRO. Kept separate from the core for lifecycle reasons - DAnO has no releases, and an unreleased third-party vocabulary should not force a version bump on a module downstream consumers pin. Full rationale and per-term verdicts: https://burohappoldmachinelearning.github.io/ADIRO/design-decisions/dano-comparison/" ;

    dcterms:title "ADIRO - DAnO compatibility layer" ;
    dcterms:description "Optional, annotation-level crosswalk between ADIRO and DAnO. Not imported by any ADIRO core module." ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:creator "Buro Happold - Machine Learning R&D" ;
    dcterms:publisher "Buro Happold" ;
    rdfs:seeAlso <https://w3id.org/dano> ;
    owl:imports <https://w3id.org/adiro/aec_provenance> ;
    owl:versionIRI <https://w3id.org/adiro/aec_dano_alignment/1.0.0> ;
    owl:versionInfo "1.0.0" .

#################################################################
#    About DAnO, and why every mapping below is annotation-level
#
#    DAnO (Drawing Analysis Ontology, https://w3id.org/dano, CC BY 4.0, RUB
#    Informatik im Bauwesen) covers adjacent ground: a DrawingElementMeta object
#    carrying inferredAt / inferredBy / inferredFrom / inferredWith, plus
#    hasConfidence on the drawing element, plus a depicts / isDepictedBy pair
#    that ADIRO does not currently mirror.
#
#    ADIRO supersedes those terms rather than reusing them, and asserts NO
#    rdfs:subPropertyOf alignment to any of them, for three separate reasons:
#
#      - inferredBy / inferredWith / inferredFrom: DAnO's are DATATYPE
#        properties holding strings; ADIRO's are OBJECT properties pointing at
#        entities. A sub-property axiom across that boundary is ill-typed and
#        outside OWL 2 DL, so the blocking reasoning gate rejects it outright.
#
#      - inferredAt: DAnO's range is xsd:date; ADIRO's is xsd:dateTime. The two
#        datatypes are disjoint, so an inherited range would make every
#        timestamp ADIRO records inconsistent.
#
#      - hasConfidence: DAnO asserts rdfs:domain dano:DrawingElement. In OWL a
#        domain is an inference rule, not a constraint, so a sub-property axiom
#        would entail that every ADIRO FieldAssertion is a drawing element -
#        filing a claim ABOUT a drawing mark under the class of drawing marks.
#        The same hazard applies to dano:depicts (rdfs:domain
#        dano:DisplayElement), which is one reason ADIRO has not minted a
#        counterpart for it.
#
#    Only the first of those fails locally. The other two stay silent while the
#    external terms are undeclared, and surface for a consumer who merges this
#    graph with DAnO itself - precisely the audience an external IRI serves.
#    The DAnO terms are therefore NOT declared here either: they appear only as
#    annotation values, so nothing about them enters any ADIRO signature.
#
#    Full comparison, per-term verdicts and evidence:
#    https://burohappoldmachinelearning.github.io/ADIRO/design-decisions/dano-comparison/
#################################################################

#################################################################
#    Provenance and confidence
#################################################################

aprov:InferenceMeta skos:closeMatch dano:DrawingElementMeta .

aprov:inferredBy skos:closeMatch dano:inferredBy .

aprov:inferredWith skos:closeMatch dano:inferredWith .

aprov:inferredFrom skos:closeMatch dano:inferredFrom .

aprov:inferredAt skos:closeMatch dano:inferredAt .

aprov:hasConfidence skos:closeMatch dano:hasConfidence .

#################################################################
#    Depiction - deliberately unmapped
#
#    dano:depicts and dano:isDepictedBy have no ADIRO counterpart yet. The
#    linking property that ORSD CQ 5.2 asks for (open issue OI-1) has not been
#    minted, because the use cases that need it specify their own with a
#    different subject: UC-06 proposes depictsMaterial and UC-07 depictsElement,
#    both with domain Drawing rather than DrawingElement. Whoever settles that
#    shape adds the mapping here, and re-adds the aec_drawing_metadata prefix and
#    owl:imports that this module dropped once it had nothing left to reference
#    there. See issue #80.
#################################################################
