@prefix : <https://w3id.org/adiro/adiro_geometry#> .
@base <https://w3id.org/adiro/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix aprov: <https://w3id.org/adiro/adiro_provenance#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

#################################################################
#    Ontology
#################################################################

<https://w3id.org/adiro/adiro_geometry> rdf:type owl:Ontology ;
    rdfs:label "ADIRO Geometry Ontology" ;
    rdfs:comment "Foundational, domain-neutral module for geometry. It records where something sits on a drawing page as a bounding box, read against an explicit coordinate frame. Each box carries its own provenance and confidence. It reuses GeoSPARQL, is imported by the drawing modules, and is shared across use cases." ;
    dcterms:title "ADIRO Geometry Ontology" ;
    dcterms:description "Bounding boxes + coordinate frames for AEC drawing extraction. Domain-neutral; provenance-bearing; GeoSPARQL-aligned." ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:creator "Buro Happold - Machine Learning R&D" ;
    dcterms:publisher "Buro Happold" ;
    dcterms:replaces <https://w3id.org/adiro/aec_geometry> ;
    owl:imports <https://w3id.org/adiro/adiro_provenance> ;
    owl:priorVersion <https://w3id.org/adiro/aec_geometry/1.0.0> ;
    owl:priorVersion <https://w3id.org/adiro/aec_geometry/1.0.1> ;
    owl:priorVersion <https://w3id.org/adiro/aec_geometry/2.0.0> ;
    owl:versionIRI <https://w3id.org/adiro/adiro_geometry/3.0.0> ;
    owl:versionInfo "3.0.0" .

#################################################################
#    GeoSPARQL term reused for alignment
#
#    Declared locally (not owl:imports) so the module stays self-contained and
#    the reasoning CI resolves everything offline via catalog-v001.xml without
#    fetching GeoSPARQL over the network. This is a minimal typing stub for the
#    one GeoSPARQL term our shapes subclass; the authoritative definition lives
#    at http://www.opengis.net/ont/geosparql#. Reusing geo:Geometry (rather than
#    minting our own shape class) is an option-1A external reference per
#    the external-ontology-imports design decision (Discussion #74): GeoSPARQL is a stable,
#    maintained OGC standard, the alignment (BoundingBox is a kind of geometry)
#    is sound, and "is a spatial shape" is exactly the entailment wanted.
#################################################################

geo:Geometry rdf:type owl:Class ;
    rdfs:label "Geometry" ;
    rdfs:comment "Local typing stub for GeoSPARQL's Geometry class (authoritative definition at the rdfs:isDefinedBy IRI), declared here so reasoning stays offline. Used as the supertype of BoundingBox so an ADIRO box is recognised as a spatial shape; ADIRO adopts no GeoSPARQL CRS or spatial-query profile (deferred, GitHub issue #36)." ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/geosparql#> .

#################################################################
#    Classes
#################################################################

:BoundingBox rdf:type owl:Class ;
    rdfs:label "Bounding Box" ;
    rdfs:comment "A rectangular region on a drawing page that locates something there, whether a model detected it or a person marked it - e.g. a title-block field's caption or value. Its coordinates are held as an xyxy string (bboxXYXY) and are meaningless without the CoordinateFrame it points at (inCoordinateFrame), which fixes the unit, coordinate space, origin, axes, page and exact PDF. A BoundingBox is itself an InferredEntity: it carries its own provenance (aprov:hasInferenceMeta - a detector, or a human annotator, told apart by aprov:inferredBy) and its own confidence (aprov:hasConfidence, the detector's score, absent for a hand-drawn box), which is DISTINCT from the confidence in a value read at that box. A subclass of GeoSPARQL geo:Geometry so it is recognised as a spatial shape." ;
    rdfs:subClassOf geo:Geometry , aprov:InferredEntity .

:CoordinateFrame rdf:type owl:Class ;
    rdfs:label "Coordinate Frame" ;
    rdfs:comment "A page of a file read in one coordinate convention: the named coordinate space, the unit and the profile that defines it (the datatype properties below), for the page it describes (describesPage). A page can have more than one frame (the primary page_display_pt in points, and px for raster evidence), and each states only its convention: what is true of the page itself (its number, file, rotation and size) is on the adiro_provenance:FilePage. Every image of the page that an extraction feeds to a model is a pixel frame of its own, with the resolution it was rendered or scaled to (resolutionDpi), and a crop is a frame limited to a region of the page (coversRegion), so a step that records the frame it used (prov:used) says what its model saw without the image being kept. Not an InferredEntity: a declared coordinate context, not a detection with its own confidence." .

#################################################################
#    Object Properties
#################################################################

:describesPage rdf:type owl:ObjectProperty ;
    rdfs:label "describesPage" ;
    rdfs:comment "The page (an aprov:FilePage) that this coordinate frame reads. The frames of a drawing are reached through its page: the path isOnPage / ^describesPage from the drawing, in adiro_drawing_metadata." ;
    rdfs:domain :CoordinateFrame ;
    rdfs:range aprov:FilePage .

:inCoordinateFrame rdf:type owl:ObjectProperty ;
    rdfs:label "inCoordinateFrame" ;
    rdfs:comment "The CoordinateFrame that interprets this geometry's coordinates. Required for a geometry to mean anything: the same xyxy numbers denote different regions in different frames, so equal coordinates alone never establish that two geometries are the same region." ;
    rdfs:domain geo:Geometry ;
    rdfs:range :CoordinateFrame .

:hasBoundingBox rdf:type owl:ObjectProperty ;
    rdfs:label "hasBoundingBox" ;
    rdfs:comment "The bounding box that locates a region on a drawing page. In UC-01 this is the title block's own region (a adiro_drawing_metadata:Titleblock, like every MetadataContainer, may have a hasBoundingBox): the field values are read from within that single region and are not themselves individually localised. No rdfs:domain is asserted, so the same property serves any locatable region or element - e.g. UC-03 reference symbols, when that work extends this module." ;
    rdfs:range :BoundingBox .

:coversRegion rdf:type owl:ObjectProperty ;
    rdfs:label "coversRegion" ;
    rdfs:comment "The region of the page that this frame shows, when it shows only part of it (a crop): the BoundingBox, in another frame of the same page (usually page_display_pt), whose rectangle the frame's image holds. The frame's own coordinates start at the region's top-left corner. A frame that shows the whole page has no coversRegion. Between the region and the frame there is only a uniform scale, given by the frame's resolutionDpi, so a box found in the crop is placed on the page without a transform term." ;
    rdfs:domain :CoordinateFrame ;
    rdfs:range :BoundingBox .

:imageOf rdf:type owl:ObjectProperty ;
    rdfs:label "imageOf" ;
    rdfs:comment "The coordinate frame that a kept image file shows: the rendering of a page, or a crop of it, as it was fed to a model, kept so a viewer can show it. The image is an aprov:DrawingFile with its contentHash and mediaType, and its pixels are the frame's coordinates. Only an image that is kept has a file: a frame a model saw is recorded whether or not its image is kept." ;
    rdfs:domain aprov:DrawingFile ;
    rdfs:range :CoordinateFrame .

#################################################################
#    Datatype Properties - the shape
#################################################################

:bboxXYXY rdf:type owl:DatatypeProperty ;
    rdfs:label "bboxXYXY" ;
    rdfs:comment "The rectangle as a string \"[xmin, ymin, xmax, ymax]\" in the coordinate frame's convention (xmin/ymin the top-left corner, xmax/ymax the bottom-right, under page_display_pt). The xyxy ordering is aligned to the Croissant cr:BoundingBox 'XYXY' format token, so an ADIRO box can be mapped to Croissant/CV formats by an exporter - ADIRO stores a page-point xyxy string, whereas Croissant expects a four-number array with a format declaration (background: GitHub issue #91). Interpret only together with inCoordinateFrame." ;
    rdfs:domain :BoundingBox ;
    rdfs:range xsd:string .

#################################################################
#    Datatype Properties - the coordinate frame
#################################################################

:coordinateSpace rdf:type owl:DatatypeProperty ;
    rdfs:label "coordinateSpace" ;
    rdfs:comment "The named coordinate convention that fixes the origin and axes. Primary: 'page_display_pt' - top-left origin, x rightwards, y downwards, in points. Native PDF user space and rendered-image pixels are different spaces and must be named as such; do not interchange the names." ;
    rdfs:domain :CoordinateFrame ;
    rdfs:range xsd:string .

:unit rdf:type owl:DatatypeProperty ;
    rdfs:label "unit" ;
    rdfs:comment "The unit of the coordinate values: 'pt' for the primary page_display_pt space (1 pt = 1/72 inch), 'px' for raster/pixel evidence. Display-page coordinates in pt are independent of rendering DPI." ;
    rdfs:domain :CoordinateFrame ;
    rdfs:range xsd:string .

:profileRef rdf:type owl:DatatypeProperty ;
    rdfs:label "profileRef" ;
    rdfs:comment "Reference to the versioned coordinate profile that defines the named coordinateSpace in full (origin, axes and unit), so the convention is pinned rather than only implied by the space's name." ;
    rdfs:domain :CoordinateFrame ;
    rdfs:range xsd:string .

:resolutionDpi rdf:type owl:DatatypeProperty ;
    rdfs:label "resolutionDpi" ;
    rdfs:comment "The resolution of a pixel frame, in pixels per inch of the page. For a frame that shows the whole page, a page_display_pt coordinate times resolutionDpi / 72 gives the pixel; for a crop (coversRegion), the coordinate is first taken from the region's top-left corner: (coordinate - corner) times resolutionDpi / 72. For a page rendered at 300 dpi it is 300; for that image scaled down so that its shorter side is 1200 pixels, it is the resolution the scaling gives (a decimal, such as 42.35). A frame in points has none." ;
    rdfs:domain :CoordinateFrame ;
    rdfs:range xsd:decimal .
